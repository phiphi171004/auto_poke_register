# ==========================================================
# Pokemon Auto Register Web - Environment Configuration
# Copy this file to .env for local runs (NEVER commit .env!)
# ==========================================================

# Local server port (Render injects PORT automatically)
PORT=8000

# Optional PIN lock for Web UI, REST API (/api/*), and WebSocket (/ws)
# Leave empty to disable PIN protection
ACCESS_PIN=

# ----------------------------------------------------------
# Option 1 (Recommended): Supabase PostgreSQL Transaction Pooler URI
# Replace [YOUR-DATABASE-PASSWORD] with your real Supabase DB password.
# Tables (accounts, servers, pokedex, app_settings) are auto-created on startup!
# ----------------------------------------------------------
DATABASE_URL=postgresql://postgres.tmyznmuqopkhyqycnequ:[YOUR-DATABASE-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# ----------------------------------------------------------
# Option 2 (Alternative): Supabase REST API (only used if DATABASE_URL is empty)
# Leave both empty + DATABASE_URL empty to fall back to local SQLite (data/pokemon_web.db)
# ----------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
